# 拼多多开放平台 / 多多进宝 API
# Server-side only. Do not expose these as VITE_* variables.
# PDD_CLIENT_ID 和 PDD_CLIENT_SECRET 用于服务端签名，不能暴露到前端。
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=

# 生产 PDD 商品推荐需要配置 PID；服务端会 trim 后传给 goods.search / promotion.url.generate。
PDD_PID=
# 可选：仅用于安全诊断 pid 前缀是否匹配 duo_id，不会输出完整 PID。
PDD_DUO_ID=

# /api/pdd-debug 专用；未配置时调试接口默认不可用。
ADMIN_TOKEN=

# 可选：配置后 /api/outfit-events 会把 query、generated profile、products、selected looks 写入 Supabase。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_OUTFIT_EVENTS_TABLE=outfit_events

# 可选：配置后 /api/outfit-profile 会用 OpenAI Responses + web_search 搜索平台打歌服，再回退本地规则。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
