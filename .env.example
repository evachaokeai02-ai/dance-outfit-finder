# 拼多多开放平台 / 多多进宝 API
# Server-side only. Do not expose these as VITE_* variables.
# PDD_CLIENT_ID 和 PDD_CLIENT_SECRET 用于服务端签名，不能暴露到前端。
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=

# 可选：如果你的 API 实现需要 access token，就配置这里。
PDD_ACCESS_TOKEN=

# 可选：配置后会调用 pdd.ddk.goods.promotion.url.generate 生成推广链接。
PDD_PID=

# 可选：配置后 /api/outfit-events 会把 query、generated profile、products、selected looks 写入 Supabase。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_OUTFIT_EVENTS_TABLE=outfit_events

# 可选：后续把 /api/outfit-profile 从本地规则 fallback 替换成真实模型时使用。
OPENAI_API_KEY=
